TARGET := iphone:clang:16.5:15.0
ARCHS = arm64

include $(THEOS)/makefiles/common.mk

# 只编译 VidGrab 自己的 Objective-C 源码（不含 whisper C 代码），
# 用来在 CI 上确认「液态玻璃」改动没有语法错误。
APPLICATION_NAME = VidGrabSyntax

VidGrabSyntax_FILES = $(filter-out Sources/VGConvert.m Sources/VGTranscoder.m Sources/VGLive.m Sources/VGSubtitles.m Sources/VGLyrics.m,$(wildcard Sources/*.m))
VidGrabSyntax_FRAMEWORKS = Accelerate PhotosUI UIKit Foundation AVFoundation AVKit CoreMedia Photos JavaScriptCore CoreVideo WebKit LocalAuthentication MediaPlayer UserNotifications Security AudioToolbox UniformTypeIdentifiers Network CoreImage ImageIO CoreLocation Vision
VidGrabSyntax_CFLAGS = -fobjc-arc -Wno-deprecated-declarations -Wno-unused-function -Wno-unused-variable -Iwhisper -DNDEBUG
VidGrabSyntax_CODESIGN_FLAGS = -S

include $(THEOS_MAKE_PATH)/application.mk
